// Generates the framework-mode route config (app/javascript/framework/generatedRoutes.ts) and the small wrapper modules
// it points at (app/javascript/framework/routes/generated/) from the data-mode route tree in app/javascript/AppRouter.tsx.
//
// This only exists while both builds do: AppRouter.tsx stays the source of truth until the cutover, and this keeps the
// framework build's routes in step with it. The cutover deletes AppRouter.tsx, this script and the check for it.
//
//   node script/genRoutes.mts          write the files
//   node script/genRoutes.mts --check  fail if the files on disk differ from what would be written
//
// How a route in AppRouter.tsx becomes a framework-mode route:
// - { path, lazy: lazyRoute(() => import('./X')) } just points at the module X.
// - Anything else a route has (loader, middleware, element, ErrorBoundary) needs a module to live in, so a wrapper is
//   generated: it re-exports the route exports of X (if there is one) and adds clientLoader, clientMiddleware, a default component
//   or ErrorBoundary built from the same expressions, with the imports they need.
// - Routes without a module, such as pathless layouts that only have middleware, get a wrapper without re-exports. A
//   route module without a default export renders an <Outlet />.
import fs from 'node:fs';
import path from 'node:path';
import ts from 'typescript';
import prettier from 'prettier';

const root = path.resolve(import.meta.dirname, '..');
const jsDir = path.join(root, 'app/javascript');
const appRouterFile = path.join(jsDir, 'AppRouter.tsx');
const frameworkDir = path.join(jsDir, 'framework');
const treeFile = path.join(frameworkDir, 'generatedRoutes.ts');
const wrapperDir = path.join(frameworkDir, 'routes/generated');

const header =
  '// Generated by script/genRoutes.mts from app/javascript/AppRouter.tsx. Do not edit: change AppRouter.tsx and run\n// `yarn routes:generate`. The cutover to framework mode deletes the generator and this notice.\n';

// The exports of a route module that framework mode knows about
const ROUTE_EXPORTS = [
  'default',
  'ErrorBoundary',
  'HydrateFallback',
  'clientLoader',
  'clientAction',
  'clientMiddleware',
  'handle',
  'shouldRevalidate',
];

type RouteNode = {
  path?: string;
  index?: boolean;
  id?: string; // an expression, such as NamedRoute.EventPage
  lazyModule?: string; // as written in the import(), such as ./EventsApp/ScheduleApp
  loader?: string;
  middleware?: string[];
  element?: string; // a component name
  errorBoundary?: string;
  children: RouteNode[];
};

const source = fs.readFileSync(appRouterFile, 'utf8');
const sourceFile = ts.createSourceFile(appRouterFile, source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TSX);

type ImportInfo = { module: string; kind: 'default' | 'named'; imported: string };
const imports = new Map<string, ImportInfo>();
const topLevelArrays = new Map<string, ts.ArrayLiteralExpression>();

for (const statement of sourceFile.statements) {
  if (ts.isImportDeclaration(statement) && ts.isStringLiteral(statement.moduleSpecifier)) {
    const module = statement.moduleSpecifier.text;
    const clause = statement.importClause;
    if (clause?.name) imports.set(clause.name.text, { module, kind: 'default', imported: 'default' });
    if (clause?.namedBindings && ts.isNamedImports(clause.namedBindings)) {
      for (const element of clause.namedBindings.elements) {
        imports.set(element.name.text, {
          module,
          kind: 'named',
          imported: (element.propertyName ?? element.name).text,
        });
      }
    }
  } else if (ts.isVariableStatement(statement)) {
    for (const declaration of statement.declarationList.declarations) {
      if (
        ts.isIdentifier(declaration.name) &&
        declaration.initializer &&
        ts.isArrayLiteralExpression(declaration.initializer)
      ) {
        topLevelArrays.set(declaration.name.text, declaration.initializer);
      }
    }
  }
}

function fail(node: ts.Node, message: string): never {
  const { line } = sourceFile.getLineAndCharacterOfPosition(node.getStart());
  throw new Error(`AppRouter.tsx:${line + 1}: ${message}`);
}

function entriesOf(array: ts.ArrayLiteralExpression): RouteNode[] {
  return array.elements.flatMap((element) => {
    if (ts.isObjectLiteralExpression(element)) return [nodeOf(element)];
    if (ts.isSpreadElement(element) && ts.isIdentifier(element.expression)) {
      return entriesOf(arrayNamed(element.expression.text));
    }
    return fail(element, `unsupported route entry: ${element.getText()}`);
  });
}

function arrayNamed(name: string): ts.ArrayLiteralExpression {
  const array = topLevelArrays.get(name);
  if (!array) throw new Error(`AppRouter.tsx has no top-level route array named ${name}`);
  return array;
}

function nodeOf(object: ts.ObjectLiteralExpression): RouteNode {
  const node: RouteNode = { children: [] };
  for (const property of object.properties) {
    if (!ts.isPropertyAssignment(property)) fail(property, `unsupported route property: ${property.getText()}`);
    const key = property.name.getText();
    const value = property.initializer;
    switch (key) {
      case 'path':
        if (!ts.isStringLiteral(value)) fail(value, 'path must be a string literal');
        node.path = value.text;
        break;
      case 'index':
        node.index = true;
        break;
      case 'id':
        node.id = value.getText();
        break;
      case 'lazy': {
        const match = /^lazyRoute\(\(\) => import\('([^']+)'\)\)$/.exec(value.getText());
        if (!match) fail(value, `lazy must be lazyRoute(() => import('...')), got ${value.getText()}`);
        node.lazyModule = match[1];
        break;
      }
      case 'loader':
        node.loader = value.getText();
        break;
      case 'middleware':
        if (!ts.isArrayLiteralExpression(value)) fail(value, 'middleware must be an array literal');
        node.middleware = value.elements.map((element) => element.getText());
        break;
      case 'element':
        if (!ts.isJsxSelfClosingElement(value) || value.attributes.properties.length > 0) {
          fail(value, 'element must be a self-closing element without props');
        }
        node.element = value.tagName.getText();
        break;
      case 'ErrorBoundary':
        node.errorBoundary = value.getText();
        break;
      case 'children':
        if (ts.isArrayLiteralExpression(value)) node.children = entriesOf(value);
        else if (ts.isIdentifier(value)) node.children = entriesOf(arrayNamed(value.text));
        else fail(value, 'children must be an array literal or the name of one');
        break;
      default:
        fail(property, `unsupported route property ${key}`);
    }
  }
  return node;
}

function resolveModuleFile(specifier: string): string {
  const base = path.resolve(jsDir, specifier);
  for (const candidate of [`${base}.tsx`, `${base}.ts`, path.join(base, 'index.tsx'), path.join(base, 'index.ts')]) {
    if (fs.existsSync(candidate)) return candidate;
  }
  throw new Error(`Can't find the module ${specifier}`);
}

// The names a module exports, by reading its syntax (so that a wrapper can re-export them explicitly)
function exportsOf(file: string): Set<string> {
  const moduleSource = ts.createSourceFile(
    file,
    fs.readFileSync(file, 'utf8'),
    ts.ScriptTarget.Latest,
    true,
    ts.ScriptKind.TSX,
  );
  const names = new Set<string>();
  for (const statement of moduleSource.statements) {
    const isExported =
      ts.canHaveModifiers(statement) && ts.getModifiers(statement)?.some((m) => m.kind === ts.SyntaxKind.ExportKeyword);
    if (ts.isVariableStatement(statement) && isExported) {
      for (const declaration of statement.declarationList.declarations) {
        if (ts.isIdentifier(declaration.name)) names.add(declaration.name.text);
      }
    } else if ((ts.isFunctionDeclaration(statement) || ts.isClassDeclaration(statement)) && isExported) {
      if (ts.getModifiers(statement)?.some((m) => m.kind === ts.SyntaxKind.DefaultKeyword)) names.add('default');
      else if (statement.name) names.add(statement.name.text);
    } else if (ts.isExportDeclaration(statement)) {
      if (!statement.exportClause) throw new Error(`${file} uses export *, which this generator can't follow`);
      if (ts.isNamedExports(statement.exportClause)) {
        for (const element of statement.exportClause.elements) names.add(element.name.text);
      }
    } else if (ts.isExportAssignment(statement)) {
      names.add('default');
    }
  }
  return names;
}

const outputs = new Map<string, string>(); // absolute path -> content
const usedWrapperNames = new Set<string>();
const usedFiles = new Map<string, number>(); // route module file -> how many routes point straight at it

function slug(parts: string[]): string {
  const name =
    parts
      .join('__')
      .replace(/[^A-Za-z0-9_$-]+/g, '_')
      .replace(/^_+|_+$/g, '') || 'route';
  let candidate = name;
  for (let n = 2; usedWrapperNames.has(candidate); n++) candidate = `${name}-${n}`;
  usedWrapperNames.add(candidate);
  return candidate;
}

function importStatements(identifiers: Set<string>, fromDir: string): string[] {
  const byModule = new Map<string, { default?: string; named: string[] }>();
  for (const identifier of [...identifiers].sort()) {
    const info = imports.get(identifier);
    if (!info) continue;
    const module = info.module.startsWith('.')
      ? path.relative(fromDir, path.resolve(jsDir, info.module)).replace(/^(?!\.)/, './')
      : info.module;
    const entry = byModule.get(module) ?? { named: [] };
    if (info.kind === 'default') entry.default = identifier;
    else entry.named.push(info.imported === identifier ? identifier : `${info.imported} as ${identifier}`);
    byModule.set(module, entry);
  }
  return [...byModule.entries()].map(([module, { default: defaultName, named }]) => {
    const parts = [defaultName, named.length > 0 ? `{ ${named.join(', ')} }` : undefined].filter(Boolean);
    return `import ${parts.join(', ')} from '${module}';`;
  });
}

function identifiersIn(...texts: string[]): Set<string> {
  const found = new Set<string>();
  for (const text of texts) {
    for (const match of text.matchAll(/[A-Za-z_$][A-Za-z0-9_$]*/g)) {
      if (imports.has(match[0])) found.add(match[0]);
    }
  }
  return found;
}

function needsWrapper(node: RouteNode): boolean {
  return (
    node.loader != null ||
    node.middleware != null ||
    node.element != null ||
    node.errorBoundary != null ||
    node.lazyModule == null
  );
}

// Returns the file (relative to the framework directory) that the route should point at, generating a wrapper if the
// route has more than a module
function fileFor(node: RouteNode, ancestors: string[]): string {
  if (!needsWrapper(node)) {
    return path.relative(frameworkDir, resolveModuleFile(node.lazyModule!));
  }

  const lines: string[] = [];
  const overridden = new Set<string>();
  const expressions: string[] = [];

  if (node.loader != null) {
    overridden.add('clientLoader');
    lines.push(`export const clientLoader = ${node.loader};`);
    expressions.push(node.loader);
  }
  if (node.middleware != null) {
    overridden.add('clientMiddleware');
    lines.push(`export const clientMiddleware = [${node.middleware.join(', ')}];`);
    expressions.push(...node.middleware);
  }
  if (node.element != null) {
    overridden.add('default');
    lines.push(`export default ${node.element};`);
    expressions.push(node.element);
  }
  if (node.errorBoundary != null) {
    overridden.add('ErrorBoundary');
    lines.push(`export const ErrorBoundary = ${node.errorBoundary};`);
    expressions.push(node.errorBoundary);
  }

  const reexports: string[] = [];
  let reexportFrom = '';
  if (node.lazyModule != null) {
    const moduleFile = resolveModuleFile(node.lazyModule);
    const available = exportsOf(moduleFile);
    for (const name of available) {
      if (!ROUTE_EXPORTS.includes(name)) continue;
      if (overridden.has(name)) continue;
      reexports.push(name);
    }
    reexportFrom = path.relative(wrapperDir, moduleFile.replace(/\.tsx?$/, '')).replace(/^(?!\.)/, './');
  }

  const name = slug([...ancestors, node.path ?? (node.index ? 'index' : 'layout')]);
  const body = [
    header.trimEnd(),
    '',
    ...importStatements(identifiersIn(...expressions), wrapperDir),
    ...(reexports.length > 0 ? [`export { ${reexports.sort().join(', ')} } from '${reexportFrom}';`] : []),
    ...lines,
    ...(lines.length === 0 && reexports.length === 0 ? ['export {};'] : []),
    '',
  ].join('\n');
  const wrapperFile = path.join(wrapperDir, `${name}.ts`);
  outputs.set(wrapperFile, body);
  return path.relative(frameworkDir, wrapperFile);
}

function literal(value: string): string {
  return `'${value.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
}

const emittedUses = new Map<string, number>();

function emit(node: RouteNode, ancestors: string[]): string {
  const file = fileFor(node, ancestors);
  const children = node.children.map((child) => emit(child, node.path != null ? [...ancestors, node.path] : ancestors));

  // Two routes can use the same file (a module mounted in two places); framework mode wants every route id to be unique
  const moduleFile = path.resolve(frameworkDir, file);
  let id = node.id;
  const uses = usedFiles.get(moduleFile) ?? 0;
  if (id == null && uses > 1) {
    const count = (emittedUses.get(moduleFile) ?? 0) + 1;
    emittedUses.set(moduleFile, count);
    if (count > 1) id = literal(`${file.replace(/\.tsx?$/, '').replace(/^(\.\.\/)+/, '')}#${count}`);
  }
  const options = id != null ? `{ id: ${id} }` : undefined;
  const childArray = children.length > 0 ? `[${children.join(',')}]` : undefined;
  // route(path, file, options?, children?) and layout(file, options?, children?) both take the children in place of
  // the options when there aren't any
  const rest = (...args: (string | undefined)[]) => args.filter((arg): arg is string => arg != null);

  if (node.index) {
    return `index(${rest(literal(file), options).join(', ')})`;
  }
  if (node.path != null) {
    return `route(${rest(literal(node.path), literal(file), options, childArray).join(', ')})`;
  }
  return `layout(${rest(literal(file), options, childArray).join(', ')})`;
}

const rootNodes = entriesOf(arrayNamed('appRootRoutes'));

// Count how many routes point straight at each module, so that repeats can be given unique ids
function countUses(nodes: RouteNode[]) {
  for (const node of nodes) {
    if (!needsWrapper(node)) {
      const file = resolveModuleFile(node.lazyModule!);
      usedFiles.set(file, (usedFiles.get(file) ?? 0) + 1);
    }
    countUses(node.children);
  }
}
countUses(rootNodes);

const entries = rootNodes.map((node) => emit(node, []));

const treeSource = `${header}import { index, layout, route, type RouteConfigEntry } from '@react-router/dev/routes';
import { NamedRoute } from '../NamedRoute';

const generatedRoutes: RouteConfigEntry[] = [${entries.join(',')}];

export default generatedRoutes;
`;
outputs.set(treeFile, treeSource);

async function main() {
  const prettierConfig = (await prettier.resolveConfig(treeFile)) ?? {};
  const formatted = new Map<string, string>();
  for (const [file, content] of outputs) {
    formatted.set(file, await prettier.format(content, { ...prettierConfig, filepath: file }));
  }

  const check = process.argv.includes('--check');
  const existingWrappers = fs.existsSync(wrapperDir)
    ? fs.readdirSync(wrapperDir).map((name) => path.join(wrapperDir, name))
    : [];
  const stale = existingWrappers.filter((file) => !formatted.has(file));

  if (check) {
    const problems: string[] = [];
    for (const [file, content] of formatted) {
      if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== content) problems.push(path.relative(root, file));
    }
    for (const file of stale) problems.push(`${path.relative(root, file)} (no longer generated)`);
    if (problems.length > 0) {
      console.error(`These generated route files are out of date with AppRouter.tsx:\n  ${problems.join('\n  ')}`);
      console.error('Run `yarn routes:generate` and commit the result.');
      process.exit(1);
    }
    console.log(`Generated route files are up to date (${formatted.size} files).`);
  } else {
    fs.mkdirSync(wrapperDir, { recursive: true });
    for (const file of stale) fs.rmSync(file);
    for (const [file, content] of formatted) fs.writeFileSync(file, content);
    console.log(`Wrote ${formatted.size} files.`);
  }
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});
