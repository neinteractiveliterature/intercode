ARG BASEIMAGE
# Optional: an earlier intercode-assets image (e.g. ghcr.io/neinteractiveliterature/intercode-assets:latest) whose
# hashed files are carried over into this image, so that tabs and cached pages from the previous release can still
# load their chunks. The default, an empty image, carries nothing over and leaves this build unchanged.
ARG PREVIOUS_ASSETS_IMAGE=scratch
# Carried-over files are pruned once they are this many days old. Files that are part of this release are never pruned.
ARG PREVIOUS_ASSETS_RETENTION_DAYS=30

FROM ${PREVIOUS_ASSETS_IMAGE} as previous

FROM ${BASEIMAGE} as code
# Make assets readable
USER root
RUN chown root.root -R /usr/src/intercode/public

# Create an nginx snippet here, to keep final image
# as small as possible.
RUN node script/genNginxNocache.js > /usr/src/intercode/public/cache.conf

 # Copy into http server
FROM nginx
RUN  rm /usr/share/nginx/html/index.*
COPY --from=code /usr/src/intercode/public /usr/share/nginx/html
ARG PREVIOUS_ASSETS_RETENTION_DAYS
# Add the previous image's files that this release doesn't have, after pruning the ones that have aged out (-p keeps
# their age, so a file's age is the time since the release that last built it). cp -n never overwrites, so this
# release's own files are never pruned or replaced.
RUN --mount=type=bind,from=previous,target=/previous \
    if [ -d /previous/usr/share/nginx/html/packs ]; then \
      cp -rp /previous/usr/share/nginx/html/packs /tmp/previous-packs && \
      find /tmp/previous-packs -type f -mtime +${PREVIOUS_ASSETS_RETENTION_DAYS} -delete && \
      cp -rnp /tmp/previous-packs/. /usr/share/nginx/html/packs/ && \
      rm -rf /tmp/previous-packs; \
    fi
RUN  touch /usr/share/nginx/html/index.html && \
     chmod 644 /usr/share/nginx/html/index.html && \
     chown www-data.root -R /usr/share/nginx/html && \
     mv  /usr/share/nginx/html/cache.conf /etc/nginx/ && \
     mkdir -p /var/run/nginx
COPY nginx-assets.conf /etc/nginx/conf.d/default.conf
