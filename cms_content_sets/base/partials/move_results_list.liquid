---
admin_notes: Formats a list of automatic changes to event signups for team member notifications
---
<ul>
  {%- for move_result in move_results -%}
    <li>
      <a href="mailto:{{ move_result.signup.user_con_profile.email }}">{{ move_result.signup.user_con_profile.name }}</a>:
      {{ move_result.prev_state }}
      {% if move_result.prev_bucket_name -%}
        ({{ move_result.prev_bucket_name }})
      {%- endif %}
      →
      {{ move_result.state }}
      {% if move_result.bucket_name -%}
        ({{ move_result.bucket_name }})
      {%- endif %}
    </li>
  {%- endfor -%}
</ul>
