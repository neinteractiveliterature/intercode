# Copy this to .env next to docker-compose.example.yml and fill it in.

# The tag of both images: a release such as 8.7.0, a commit SHA, or latest
INTERCODE_VERSION=latest

# The domain the root site is served from (convention sites use their own domains, which Intercode looks up by Host)
INTERCODE_HOST=intercode.example.org

# Leave empty to serve assets from the same domain as the app. To use a separate asset host, put its name here (a bare
# host name, optionally with a port, with no scheme).
ASSETS_HOST=

POSTGRES_PASSWORD=change-me

# Generate these with: openssl rand -hex 64
SECRET_KEY_BASE=
DEVISE_SECRET_KEY=

# An RSA private key for signing OpenID Connect tokens, on one line with \n for the line breaks:
#   openssl genrsa 2048 | awk 'NF {printf "%s\\n", $0}'
OPENID_CONNECT_SIGNING_KEY=

# Uploaded files (convention logos, event images and so on) are stored in S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
