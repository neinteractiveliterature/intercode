{
  "labels": ["dependencies"],
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["rails"],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "matchPackageNames": ["graphql", "graphql-batch"],
      "enabled": false
    },
    {
      "matchPackageNames": ["postgres"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "description": "Our own npm packages are listed in npmPreapprovedPackages in .yarnrc.yml, which exempts them from yarn's age gate, so don't make Renovate wait for them either",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@neinteractiveliterature/**"],
      "minimumReleaseAge": null
    }
  ],
  "postUpdateOptions": ["yarnDedupeHighest"],
  "toolSettings": {
    "nodeMaxMemory": 2048
  },
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "1 day"
}
