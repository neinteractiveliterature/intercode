{
  "compilerOptions": {
    "outDir": "./dist/", // path to output directory
    "sourceMap": true, // allow sourcemap support
    "strict": false, // TypeScript 7 defaults this to true; keep the existing behavior
    "strictNullChecks": true, // enable strict null checks as a best practice
    "module": "es2020", // specify module code generation
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx", // use typescript to transpile jsx to js
    "target": "es6", // specify ECMAScript target version
    "allowJs": true, // allow a partial TypeScript and JavaScript codebase,
    "allowSyntheticDefaultImports": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "vite/client"],
    "paths": {
      "*": ["./app/javascript/*"]
    }
  },
  "include": [
    "./app/javascript/",
    "./script",
    "./test/javascript/",
    "script/buildTimezoneData.js",
    "graphql.config.js",
    "i18next-parser-english.config.cjs",
    "i18next-parser-non-english.config.cjs"
  ]
}
